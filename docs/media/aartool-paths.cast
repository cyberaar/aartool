[2.617008, "o", "\r\n"]
[3.151715, "o", "\r\n  \u001b[1mAttack paths\u001b[0m  demo-server-01\r\n"]
[3.152264, "o", "  \u001b[0;36mDerived from demo-audit.json. Nothing was scanned or changed.\u001b[0m\r\n"]
[3.152342, "o", "  \u001b[1m3 of 4 chains are complete.\u001b[0m Cut one link in each.\r\n"]
[3.17902, "o", "\r\n  \u001b[0;31m● COMPLETE\u001b[0m  \u001b[1mThe local climb: any shell to root\u001b[0m\r\n"]
[3.179114, "o", "    \u001b[0;31mFind a kernel doorway\u001b[0m ▸ \u001b[0;31mNothing contains the exploit\u001b[0m"]
[3.179183, "o", "\r\n    3 open                  "]
[3.17924, "o", "1 open\r\n"]
[3.17936, "o", "    \u001b[1mcut\u001b[0m  \u001b[1;33mKRN-12\u001b[0m  Primary LPE doorways open\r\n"]
[3.186178, "o", "\r\n  \u001b[0;31m● COMPLETE\u001b[0m  \u001b[1mThe silent tenant: root to never found\u001b[0m\r\n"]
[3.186272, "o", "    \u001b[0;31mPersist below the OS\u001b[0m ▸ \u001b[0;31mNobody is recording\u001b[0m"]
[3.18641, "o", " ▸ \u001b[0;31mNobody would notice a change\u001b[0m\r\n    4 open                 3 open                "]
[3.186516, "o", "4 open\r\n"]
[3.186658, "o", "    \u001b[1mcut\u001b[0m  \u001b[1;33mKRN-06\u001b[0m  kexec allowed\r\n"]
[3.193512, "o", "\r\n  \u001b[0;31m● COMPLETE\u001b[0m  \u001b[1mThe pivot: one box to the next\u001b[0m\r\n"]
[3.193603, "o", "    \u001b[0;31mTunnel out through it\u001b[0m"]
[3.193673, "o", " ▸ \u001b[0;31mSpoof or redirect on the wire\u001b[0m ▸ \u001b[0;31mNo default-deny on the way out\u001b[0m\r\n    2 open                  "]
[3.193887, "o", "4 open                          1 open\r\n"]
[3.193955, "o", "    \u001b[1mcut\u001b[0m  \u001b[1;33mSSH-04\u001b[0m  TCP Forwarding enabled\r\n"]
[3.199122, "o", "\r\n  \u001b[0;32m○\u001b[0m  \u001b[1mThe front door: internet to root\u001b[0m   \u001b[0;32mbroken: \"Land as root, or become it\" is closed\u001b[0m\r\n"]
[3.199217, "o", "\r\n  \u001b[0;36maartool explain <ID>\u001b[0m  why a link matters\r\n  \u001b[0;36m--detail\u001b[0m  every finding   \u001b[0;36m--format mermaid\u001b[0m  a diagram\r\n\r\n"]
[11.200789, "o", "\r\n$ a"]
[11.248001, "o", "a"]
[11.294917, "o", "r"]
